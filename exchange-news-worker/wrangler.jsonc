{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exchange-news-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "STATE_KV"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITOR",
        "class_name": "ExchangeMonitor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ExchangeMonitor"
      ]
    }
  ]
}
